# AeroSovereign Frontend Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Backend API Base URL (FastAPI air-gapped server)
VITE_API_URL=http://localhost:8000/api/v1

# Application Title & Deployment Identifiers
VITE_APP_TITLE="AeroSovereign AI Workbench"
VITE_ORGANIZATION="Mangalore Refinery and Petrochemicals Limited (MRPL)"
VITE_PROBLEM_STATEMENT="PS-26117"

# Local Sovereign Inference Node
VITE_AIR_GAPPED_MODE=true
VITE_DEFAULT_MODEL="DeepSeek-R1-14B"
